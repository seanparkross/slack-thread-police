# Slack app credentials (see docs/setup.md for creating the app from slack-app-manifest.yml)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# Optional: a workspace admin's User OAuth Token (xoxp-...). When set, "Move to thread" also
# deletes the original message. Only works if that admin is allowed to delete others' messages.
# SLACK_USER_TOKEN=xoxp-...

# TypeSafe Jev — bring your own key from https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Point at any /v1/systemone-compatible server (e.g. a local llama-server) to self-host the model.
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_MODEL=jev-latest
# Per-attempt timeout in milliseconds. Raise it for slower self-hosted models.
# TYPESAFE_TIMEOUT_MS=10000
# Request body compression: auto (zstd where Node supports it), zstd, or off.
# Set to off if your self-hosted server rejects compressed requests.
# TYPESAFE_COMPRESSION=auto

# Tuning (defaults shown)
# Minimum P(new message is a reply to something).
# REPLY_THRESHOLD=0.75
# Minimum P(that specific earlier message is the parent).
# PARENT_THRESHOLD=0.6
# How many recent top-level messages to consider.
# CONTEXT_MESSAGES=20
# Ignore candidates older than this.
# CONTEXT_MAX_AGE_MINUTES=120
# At most one nudge per person in this window (0 disables the cooldown).
# USER_COOLDOWN_MINUTES=10
# 0 nudges right away. Above 0, wait this long after someone's last follow-up so a burst gets one nudge that counts it.
# NUDGE_DELAY_SECONDS=0
# Where /threadpolice opt-outs and snoozes (user ids and times) and nudge counts (channel ids and
# numbers) are saved, never messages.
# DATA_DIR=data
# debug, info, warn or error. Note: debug makes Slack's SDK log raw event payloads, including message text.
# LOG_LEVEL=info
